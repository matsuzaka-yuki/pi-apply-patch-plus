{
  "name": "pi-apply-patch-plus",
  "version": "0.1.3",
  "description": "Pi extension that brings Codex-style apply_patch to pi: patch-based multi-file editing with local verification, diff UI, and smart GPT model detection.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "apply-patch",
    "patch"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/matsuzaka-yuki/pi-apply-patch-plus.git"
  },
  "files": [
    "src",
    "README.md",
    "README.zh-CN.md"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-ai": "*",
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*",
    "@sinclair/typebox": "*"
  },
  "devDependencies": {
    "@mariozechner/pi-tui": "0.53.0",
    "@types/node": "^24.3.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/*.test.ts"
  }
}
